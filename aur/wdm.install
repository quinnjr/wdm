post_install() {
	cat <<-MSG
	>>> wdm runs on VT 7 and does not touch VT 1, so Ctrl+Alt+F1 stays a
	    working text console. Verify you can reach it before enabling the
	    unit: if wdm fails to start you will have no graphical login.

	>>> The DRM path has not yet run on real hardware. Development uses a
	    nested backend that cannot exercise DRM, the seat, or the handoff
	    to a session.

	>>> Configuration is /etc/wdm/wdm.toml. Enable with:
	        systemctl enable wdm.service
	MSG
}

post_upgrade() {
	post_install
}

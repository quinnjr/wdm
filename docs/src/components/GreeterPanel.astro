---
// A facsimile of wdm's actual login panel. It is the product's face, and it
// says what wdm is faster than a paragraph does — so it opens the site and
// appears nowhere else.
const sessions = ["GNOME", "Hyprland", "Plasma (Wayland)", "Sway"];
---

<div
  class="rounded-xl border border-edge bg-panel p-7 shadow-sm sm:p-9"
  role="img"
  aria-label="The wdm login screen: a user field, a password field, and a session picker."
>
  <p class="font-sans text-xl font-semibold tracking-tight text-text">Sign in</p>

  <p class="mt-5 font-mono text-[0.7rem] uppercase tracking-widest text-dim">User</p>
  <div class="mt-1.5 flex items-center justify-between rounded-md border border-edge bg-surface px-3 py-2">
    <span class="font-mono text-sm text-text">ada</span>
    <span class="text-dim" aria-hidden="true">▾</span>
  </div>

  <p class="mt-4 font-mono text-[0.7rem] uppercase tracking-widest text-dim">Password</p>
  <div class="mt-1.5 flex items-center rounded-md border border-edge bg-surface px-3 py-2">
    <span class="font-mono text-sm tracking-[0.2em] text-text">••••••••</span>
    <span class="caret ml-0.5 inline-block h-4 w-px bg-beam" aria-hidden="true"></span>
  </div>

  <p class="mt-4 font-mono text-[0.7rem] uppercase tracking-widest text-dim">Session</p>
  <div class="mt-1.5 flex items-center justify-between rounded-md border border-edge bg-surface px-3 py-2">
    <span class="font-mono text-sm text-text">{sessions[0]}</span>
    <span class="text-dim" aria-hidden="true">▾</span>
  </div>

  <p class="mt-5 font-mono text-[0.7rem] text-dim">
    vt 7 · seat0 · {sessions.length} sessions
  </p>
</div>

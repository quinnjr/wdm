#!/bin/sh
# Debian has no file triggers for sysusers.d or tmpfiles.d — Fedora's systemd
# package runs both automatically on install, Debian's does not — so the
# greeter account and its state directory are created here instead.
set -e

if [ "$1" = configure ]; then
    # Neither output nor exit status is discarded here, for the same reason as
    # daemon-reload below: these two calls decide whether wdm can start at all.
    # Without the account wdm exits 1 at startup; without /var/empty the greeter
    # is never spawned, because wdm chdirs into it before exec. Swallowing
    # either leaves an administrator with a display manager that fails for no
    # visible reason. Non-fatal all the same — an install must not abort.
    systemd-sysusers /usr/lib/sysusers.d/wdm.conf \
        || echo "wdm: creating the wdm account failed; wdm.service will not start" >&2
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/wdm.conf \
        || echo "wdm: creating /var/lib/wdm and /var/empty failed; the greeter will not spawn" >&2

    # systemd-sysusers never modifies an account that already exists, so a
    # machine that installed 0.1.x keeps the greeter's home at /var/lib/wdm
    # forever — the directory root creates and renames files in, which is
    # exactly what the home was moved out of. Guarded on the old value so it is
    # idempotent and so an administrator who chose a different home is left
    # alone.
    if [ "$(getent passwd wdm | cut -d: -f6)" = /var/lib/wdm ]; then
        usermod -d /var/empty wdm \
            || echo "wdm: could not move the wdm account's home to /var/empty" >&2
    fi

    # Make the freshly installed unit visible to systemd, so that a
    # `systemctl enable wdm` typed right after install works. This reloads
    # only; enabling stays the administrator's decision, per below.
    #
    # Guarded on /run/systemd/system rather than on the exit status: in a
    # chroot or a container there is no PID 1 to talk to and the failure means
    # nothing, but a malformed unit or a D-Bus failure on a real system is
    # exactly what the administrator needs to hear about, and swallowing it
    # leaves them with an `systemctl enable wdm` that fails for no visible
    # reason. Non-fatal either way — an install must not abort over it.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload \
            || echo "wdm: systemctl daemon-reload failed; run it before enabling wdm.service" >&2
    fi

    # Deliberately not enabling wdm.service. A machine being installed onto
    # already has a display manager, and enabling a second one that claims
    # display-manager.service is how a boot ends with no login screen at all.
    :
fi

# No prerm or postrm is shipped, deliberately. `apt purge` therefore leaves the
# wdm account, /var/lib/wdm and /var/empty behind. Accounts created by
# sysusers.d are conventionally never removed — a uid that files elsewhere may
# still be owned by should not be handed to the next account allocated — and
# /var/empty belongs to the base filesystem package on Arch and Fedora, so
# deleting it here would be removing another package's directory on the one
# distribution where wdm happens to create it. The conffiles dpkg does remove
# on purge are declared as such in the package metadata, not handled here.
